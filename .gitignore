# pesados do preparo de fichas (040): áudio, quadros, legendas brutas; refazíveis com npm run fichas -- preparar
data/intel/

# curadoria (041): brutos, candidatos, achados e páginas baixadas; refazíveis com npm run curadoria
data/curadoria/

# variantes de vídeo (045 B): a composição é gerada pelo variantes.mjs/compor a cada rodada
companies/*/contents/*/variantes/*/composition.html
# medidas de tela da base para o QC de sincronia (045 C): cache, refeito sozinho
companies/*/contents/*/variantes/qc-base.json

# backups do "Restaurar esta versão" (050 D): ficam no disco, fora do git
companies/**/versoes/_backup-*/

# relatórios em PDF (skill relatorio-pdf): fica no git só o relatorio.json (a análise); dados, PNG e PDF refazem com tools/relatorio/
companies/*/intel/relatorios/*/png/
companies/*/intel/relatorios/*/*.pdf
companies/*/intel/relatorios/*/dados.json
companies/*/intel/relatorios/*/esqueleto.json
